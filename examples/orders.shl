// Order/payment demo API with a Checkout protocol (rules + protocol).
rule CreateOrder on POST "/api/orders" {
  field client_ref : string matches /^[a-z0-9-]{1,32}$/;
  field item       : string maxlen 64;
  body max_depth 3 max_size 2 KB;
}
rule PayOrder on POST "/api/orders/{id}/pay" {
  param id         : string matches /^ord_[0-9]+$/;
  field card_token : string matches /^tok_[a-z0-9]{1,16}$/;
  body max_depth 3 max_size 2 KB;
}
rule ConfirmOrder on POST "/api/orders/{id}/confirm" {
  param id         : string matches /^ord_[0-9]+$/;
  field card_token : string matches /^tok_[a-z0-9]{1,16}$/;
  body max_depth 3 max_size 2 KB;
}
rule GetOrder on GET "/api/orders/{id}" {
  param id : string matches /^ord_[0-9]+$/;
}

// Checkout protocol: an order must be paid (with the SAME card token) before it can be confirmed.
protocol Checkout {
  resource "order";
  states created, paid, confirmed;
  initial created;
  terminal confirmed;
  key id;
  create CreateOrder id "id" ref client_ref probe get "/api/orders/by-ref/{ref}";
  step PayOrder     from created to paid;
  step ConfirmOrder from paid    to confirmed;
  bind PayOrder.card_token == ConfirmOrder.card_token;
  outcome success 200..201;
  outcome failure 402;
  contract "Demo backend returns 402 only when the card was declined and no state changed.";
  quiesce 2;
  reconcile get "/api/orders/{key}" state "state" owner "owner" {
    "created": created, "paid": paid, "confirmed": confirmed
  };
}
