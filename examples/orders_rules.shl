// Order/payment demo API: stateless request validation (the protocol block is added in orders.shl).
rule CreateOrder on POST "/api/orders" {
  field client_ref : string matches /^[a-z0-9-]{1,32}$/;
  field item       : string maxlen 64;
  body max_depth 3 max_size 2 KB;
}
rule PayOrder on POST "/api/orders/{id}/pay" {
  param id         : string matches /^ord_[0-9]+$/;
  field card_token : string matches /^tok_[a-z0-9]{1,16}$/;
  body max_depth 3 max_size 2 KB;
}
rule ConfirmOrder on POST "/api/orders/{id}/confirm" {
  param id : string matches /^ord_[0-9]+$/;
  body max_depth 3 max_size 2 KB;
}
rule GetOrder on GET "/api/orders/{id}" {
  param id : string matches /^ord_[0-9]+$/;
}
